# InsForge Configuration
# Get these values from your InsForge dashboard: https://insforge.dev

# Public backend URL used by Vite for database/storage requests
VITE_INSFORGE_URL=https://your-app.region.insforge.app

# Server-side URL used by the Vercel same-origin auth proxy.
# Set this to the same value in Vercel Production, Preview, and Development.
INSFORGE_URL=https://your-app.region.insforge.app

# Optional override when the auth proxy is hosted somewhere other than this app.
# Leave unset for the included Vercel /api/auth proxy.
# VITE_AUTH_PROXY_URL=https://your-app.example.com

# Anonymous key (optional, only needed for database/storage operations)
VITE_INSFORGE_ANON_KEY=your_insforge_anon_key_here
