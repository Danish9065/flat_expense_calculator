# Supabase application configuration
# The publishable key is safe for browser use; RLS protects every data row.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional, server-only InsForge recovery tooling. Never prefix the admin key
# with VITE_ and never commit its value.
INSFORGE_URL=https://your-app.region.insforge.app
INSFORGE_API_KEY=your_server_only_recovery_key
